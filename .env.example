# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL base onde a aplicação está hospedada (ex: http://localhost:3000 ou https://vybe.app)
APP_URL="http://localhost:3000"

# SUPABASE CONFIGURATION (Frontend Client)
# Obtenha em: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# SUPABASE SERVICE ROLE KEY (USO EXCLUSIVO NO BACKEND / SERVER-SIDE)
# NUNCA exponha esta chave no frontend nem envie com valores reais para o GitHub!
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-only-for-backend"

# ADMINISTRAÇÃO PRINCIPAL
# E-mail do Superadministrador autorizado na plataforma
PRIMARY_ADMIN_EMAIL="tomsilvaconsignado@gmail.com"

# SERVIDOR
PORT=3000
NODE_ENV="development"

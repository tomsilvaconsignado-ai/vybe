# APP_URL: URL base onde a aplicação está hospedada (ex: http://localhost:3000 ou https://vybe.app)
APP_URL="http://localhost:3000"

# SUPABASE (Frontend)
# Obtenha em: Supabase Dashboard -> Project Settings -> API Keys
# A chave "publishable" (sb_publishable_...) ou a antiga "anon" é pública e pode ir para o navegador.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# SUPABASE SECRET / SERVICE ROLE KEY (USO EXCLUSIVO NO BACKEND)
# Ignora todas as regras de segurança (RLS). Nunca use no frontend nem envie para o GitHub.
# O app atual não precisa dela.
# SUPABASE_SERVICE_ROLE_KEY="your-secret-key-only-for-backend"

# SERVIDOR
PORT=3000
